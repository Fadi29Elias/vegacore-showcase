---
// Root: Arabic is the default language.
import { url } from '../i18n/ui';
const target = url('/ar/');
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <title>VegaCore</title>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
  </head>
  <body>
    <a href={target}>VegaCore</a>
  </body>
</html>
