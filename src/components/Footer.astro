---
import { Image } from 'astro:assets';
import logoWhite from '../assets/brand/vega-logo-white.png';
import Icon from './Icon.astro';
import { contact, useT, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer dark">
  <div class="rule"></div>
  <div class="wrap grid">
    <div class="brand">
      <Image src={logoWhite} alt="VegaCore" height={88} densities={[1, 2]} />
      <p class="tagline latin">{t('footer.tagline')}</p>
      <p class="base">{t('contact.base')}</p>
    </div>
    <ul class="contacts" role="list">
      <li>
        <a href={contact.whatsappUrl} target="_blank" rel="noopener">
          <Icon name="whatsapp" />
          <span><small>{t('contact.whatsapp')}</small><span class="num">{contact.whatsapp}</span></span>
        </a>
      </li>
      <li>
        <a href={`mailto:${contact.email}`}>
          <Icon name="mail" />
          <span><small>{t('contact.email')}</small><span class="latin">{contact.email}</span></span>
        </a>
      </li>
      <li>
        <a href={contact.instagramUrl} target="_blank" rel="noopener">
          <Icon name="instagram" />
          <span><small>{t('contact.instagram')}</small><span class="latin" dir="ltr">{contact.instagram}</span></span>
        </a>
      </li>
      <li>
        <a href={contact.webUrl} target="_blank" rel="noopener">
          <Icon name="globe" />
          <span><small>{t('contact.web')}</small><span class="latin">{contact.web}</span></span>
        </a>
      </li>
    </ul>
  </div>
  <div class="wrap signoff">
    <span class="latin">Business Development • Marketing • Technology • Strategy</span>
    <span class="num">© {year} VegaCore</span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 0;
  }
  .rule {
    height: 3px;
    background: var(--rule);
  }
  .grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 40px;
    padding-block: 56px 40px;
  }
  .brand img {
    height: 88px;
    width: auto;
  }
  .tagline {
    margin-top: 18px;
    font-style: italic;
    color: var(--gold);
    font-weight: 600;
  }
  .base {
    margin-top: 6px;
    color: var(--on-dark-muted);
    font-size: 0.95rem;
  }
  .contacts {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
    align-content: start;
  }
  .contacts a {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 16px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.04);
    color: #fff;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }
  .contacts a:hover {
    background: rgba(255, 255, 255, 0.09);
  }
  .contacts svg {
    width: 22px;
    height: 22px;
    flex: none;
    color: var(--gold);
  }
  .contacts small {
    display: block;
    color: var(--on-dark-muted);
    font-size: 0.78rem;
    line-height: 1.2;
  }
  .signoff {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding-block: 18px 28px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--on-dark-muted);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
  }
  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
