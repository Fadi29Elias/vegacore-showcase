---
// A client reel shown with Instagram's own embedded player, plus its real view count.
// The iframe height is set from Instagram's MEASURE message (see Base.astro).
import Icon from './Icon.astro';
import { igEmbed, type Reel } from '../lib/clients';
import { formatDate, tr, useT, type Lang } from '../i18n/ui';

interface Props {
  reel: Reel;
  lang: Lang;
  showClient?: boolean;
}
const { reel, lang, showClient = true } = Astro.props;
const t = useT(lang);
const c = reel.client;
const name = tr(c.data.name, lang);
const src = igEmbed(reel.code);
---

<article
  class="reel"
  data-item
  data-client={c.id}
  data-industry={c.data.industry}
  data-steps={JSON.stringify([{ t: 'ig', src }])}
  data-title={`${reel.views} ${t('reels.views')}`}
  data-who={name}
>
  <header class="head">
    {showClient ? <a class="who" href={`/${lang}/clients/${c.id}/`}>{name}</a> : <span class="who">{formatDate(reel.date, lang)}</span>}
    <span class="views"><strong class="num">{reel.views}</strong> {t('reels.views')}</span>
  </header>
  <div class="frame">
    <iframe class="ig" src={src} title={`${name} — Instagram`} loading="lazy" allowfullscreen scrolling="no"></iframe>
  </div>
  <footer class="foot">
    {showClient && <span class="date">{formatDate(reel.date, lang)}</span>}
    <button type="button" class="watch" data-open>
      <Icon name="present" /> {t('reels.watch')}
    </button>
  </footer>
</article>

<style>
  .reel {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--line);
  }
  .who {
    color: var(--navy);
    font-weight: 800;
    text-decoration: none;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  a.who:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .views {
    flex: none;
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--gold);
    color: var(--navy);
    font-size: 0.8rem;
    font-weight: 700;
  }
  .views strong {
    font-size: 1.05rem;
    font-weight: 800;
  }
  .frame {
    background: #fff;
    min-height: 420px;
  }
  .ig {
    display: block;
    width: 100%;
    height: 640px;
    border: 0;
  }
  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 16px 14px;
    margin-top: auto;
  }
  .date {
    color: var(--muted);
    font-size: 0.82rem;
  }
  .watch {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-inline-start: auto;
    padding: 6px 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--blue-pale2);
    color: var(--navy);
    font: inherit;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
  }
  .watch:hover {
    background: var(--blue-pale);
  }
  .watch :global(svg) {
    width: 16px;
    height: 16px;
  }
</style>
