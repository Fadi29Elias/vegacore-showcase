---
import Icon from './Icon.astro';
import type { Client } from '../lib/clients';
import { tr, useT, type Key, type Lang, url } from '../i18n/ui';

interface Props {
  client: Client;
  lang: Lang;
}
const { client, lang } = Astro.props;
const t = useT(lang);
const d = client.data;
const href = url(`/${lang}/clients/${client.id}/`);
const lead = d.stats[0];
const rest = d.stats.slice(1, 3);
---

<article class:list={['client', { ours: d.industry === 'vegacore' }]} data-industry={d.industry}>
  <div class="top">
    <span class="chip">{d.industry === 'vegacore' ? t('story.ours') : t(`industry.${d.industry}` as Key)}</span>
    <span class="handle latin" dir="ltr">@{d.handle}</span>
  </div>
  <h3><a href={href}>{tr(d.name, lang)}</a></h3>
  <p class="cat">{tr(d.category, lang)}</p>
  {
    lead && (
      <div class="lead">
        <span class="value num">{lead.value}</span>
        <span class="label">
          {tr(lead.label, lang)}
          {lead.from && (
            <span class="from">
              · {t('growth.before')}: <span class="num">{lead.from}</span>
            </span>
          )}
        </span>
      </div>
    )
  }
  <p class="headline">{tr(d.headline, lang)}</p>
  {
    rest.length > 0 && (
      <ul class="mini" role="list">
        {rest.map((s) => (
          <li>
            <strong class="num">{s.value}</strong>
            <span>{tr(s.label, lang)}</span>
          </li>
        ))}
      </ul>
    )
  }
  <a class="link-arrow" href={href}>{t('story.view')} <Icon name="arrow" flip /></a>
</article>

<style>
  .client {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 22px 22px 24px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-top: 4px solid var(--gold);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .client:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
  }
  .ours {
    border-top-color: var(--blue);
  }
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .handle {
    color: var(--muted);
    font-size: 0.8rem;
    direction: ltr;
  }
  h3 {
    font-size: 1.35rem;
    margin-top: 4px;
  }
  h3 a {
    color: inherit;
    text-decoration: none;
  }
  .cat {
    color: var(--muted);
    font-size: 0.9rem;
    margin-top: -6px;
  }
  .lead {
    display: grid;
    margin-top: 6px;
  }
  .lead .value {
    color: var(--navy);
    font-size: clamp(2.2rem, 4vw, 2.8rem);
    font-weight: 800;
    line-height: 1.1;
  }
  .lead .label {
    display: flex;
    gap: 8px;
    align-items: baseline;
    color: var(--blue);
    font-size: 0.86rem;
    font-weight: 700;
  }
  .from {
    color: var(--muted);
    font-weight: 600;
  }
  .headline {
    color: var(--ink);
    font-weight: 700;
    line-height: 1.6;
  }
  .mini {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin: 2px 0 0;
    padding: 12px 0 0;
    border-top: 1px dashed var(--line);
    list-style: none;
  }
  .mini li {
    display: grid;
    line-height: 1.3;
  }
  .mini strong {
    color: var(--navy);
    font-size: 1.05rem;
  }
  .mini span {
    color: var(--muted);
    font-size: 0.78rem;
  }
  .link-arrow {
    margin-top: auto;
    padding-top: 8px;
  }
  .link-arrow :global(svg) {
    width: 18px;
    height: 18px;
  }
</style>
